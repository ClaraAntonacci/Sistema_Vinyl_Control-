SELECT
    m.id_movimentacao,
    m.tipo_movimentacao,
    m.quantidade,
    m.data_movimentacao,
    d.titulo AS disco,
    u.nome AS usuario
FROM movimentacao_estoque m
INNER JOIN disco d
    ON m.id_disco = d.id_disco
INNER JOIN usuario u
    ON m.id_usuario = u.id_usuario;
